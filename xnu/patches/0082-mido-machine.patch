+/*
+ * Experimental Qualcomm MSM8953 configuration for the Redmi Note 4
+ * Snapdragon (mido). This header intentionally contains only CPU and
+ * generic architectural assumptions; SoC drivers are not present yet.
+ */
+#ifndef _PEXPERT_ARM_MIDO_H
+#define _PEXPERT_ARM_MIDO_H
+
+#define NO_MONITOR 1
+#define NO_ECORE 1
+#define MIDO 1
+#define ARM_ARCH_TIMER 1
+#define GENERIC_PSCI_SMP 1
+
+#define __ARM_ARCH__ 8
+#define __ARM_VMSA__ 8
+#define __ARM_VFP__ 4
+#define __ARM_COHERENT_CACHE__ 1
+#define __ARM_DEBUG__ 7
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+#define __ARM_16K_PG__ 1
+
+#ifndef ASSEMBLER
+#define MIDO_UART
+#endif
+
+#endif /* _PEXPERT_ARM_MIDO_H */
