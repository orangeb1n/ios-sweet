+
+static unsigned int mido_glyph(char c)
+{
+	if (c >= 'A' && c <= 'Z') return (unsigned int)(c - 'A');
+	if (c >= '0' && c <= '9') return 26u + (unsigned int)(c - '0');
+	return 36u;
+}
+
+static void mido_put_pixel(unsigned int x, unsigned int y, uint8_t r, uint8_t g, uint8_t b)
+{
+	volatile uint8_t *p = MIDO_EARLY_FB + y * MIDO_EARLY_STRIDE + x * 3u;
+	p[0] = r; p[1] = g; p[2] = b;
+}
+
+static void mido_clear_row(void)
+{
+	for (unsigned int y = 0; y < MIDO_EARLY_CELL_H; y++)
+		for (unsigned int x = 0; x < MIDO_EARLY_WIDTH; x++)
+			mido_put_pixel(x, mido_early_row * MIDO_EARLY_CELL_H + y, 0, 16, 32);
+}
+
+static void mido_putc(char c)
+{
+	if (mido_early_disabled) return;
+	if (c == '\n' || mido_early_col >= MIDO_EARLY_COLS) {
+		mido_early_col = 0;
+		mido_early_row = (mido_early_row + 1u) % MIDO_EARLY_ROWS;
+		mido_clear_row();
+		if (c == '\n') return;
+	}
+	const uint8_t *glyph = mido_font[mido_glyph(c)];
+	for (unsigned int gy = 0; gy < 7; gy++)
+		for (unsigned int sy = 0; sy < MIDO_EARLY_SCALE; sy++)
+			for (unsigned int gx = 0; gx < 5; gx++)
+				for (unsigned int sx = 0; sx < MIDO_EARLY_SCALE; sx++)
+					mido_put_pixel(mido_early_col * MIDO_EARLY_CELL_W + gx * MIDO_EARLY_SCALE + sx,
+					    mido_early_row * MIDO_EARLY_CELL_H + gy * MIDO_EARLY_SCALE + sy,
+					    (glyph[gy] & (1u << (4u - gx))) ? 255 : 0,
+					    (glyph[gy] & (1u << (4u - gx))) ? 255 : 16,
+					    (glyph[gy] & (1u << (4u - gx))) ? 255 : 32);
+	mido_early_col++;
+}
+
+void sweet_early_mark(unsigned int stage, const char *label)
+{
+	if (mido_early_disabled) return;
+	for (unsigned int x = stage * 48u; x < (stage + 1u) * 48u; x++)
+		for (unsigned int y = MIDO_EARLY_HEIGHT - 32u; y < MIDO_EARLY_HEIGHT; y++)
+			mido_put_pixel(x, y, 0, 255, (uint8_t)(stage * 12u));
+	mido_putc('S'); mido_putc('T'); mido_putc('A'); mido_putc('G'); mido_putc('E'); mido_putc(' ');
+	mido_putc((char)('0' + (stage % 10u))); mido_putc(':'); mido_putc(' ');
+	while (*label) mido_putc(*label++);
+	mido_putc('\n');
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void sweet_early_disable(void) { mido_early_disabled = 1; }
+#endif /* MIDO */
