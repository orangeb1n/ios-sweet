+
+
+#if defined(MIDO)
+#include <stdint.h>
+
+#define MIDO_EARLY_FB ((volatile uint8_t *)(uintptr_t)0x90001000)
+#define MIDO_EARLY_WIDTH 1080u
+#define MIDO_EARLY_HEIGHT 1920u
+#define MIDO_EARLY_STRIDE (MIDO_EARLY_WIDTH * 3u)
+#define MIDO_EARLY_SCALE 2u
+#define MIDO_EARLY_CELL_W (5u * MIDO_EARLY_SCALE)
+#define MIDO_EARLY_CELL_H (7u * MIDO_EARLY_SCALE)
+#define MIDO_EARLY_COLS (MIDO_EARLY_WIDTH / MIDO_EARLY_CELL_W)
+#define MIDO_EARLY_ROWS ((MIDO_EARLY_HEIGHT - 32u) / MIDO_EARLY_CELL_H)
+
+static unsigned int mido_early_row, mido_early_col;
+static unsigned int mido_early_disabled;
+
+static const uint8_t mido_font[37][7] = {
+	[0] = {0x1e, 0x05, 0x05, 0x1e, 0x14, 0x14, 0x1e},
