diff -ruN /tmp/mido-patch-base/pexpert/arm/pe_serial.c /tmp/mido-xnu-working/pexpert/arm/pe_serial.c
--- a/pexpert/arm/pe_serial.c	2026-10-27 10:17:26.045725935 +0100
+++ b/pexpert/arm/pe_serial.c	2026-10-27 10:17:06.423873027 +0100
@@ -99,6 +99,74 @@
  * but the data protection on the structs prevents it. */
 static bool serial_do_transmit = 1;
 
+#if defined(MIDO)
+static vm_offset_t mido_uart_base;
+static vm_offset_t mido_gcc_base;
+
+static inline uint32_t
+mido_uart_read(uint32_t offset)
+{
+	return *((volatile uint32_t *)(mido_uart_base + offset));
+}
+
+static inline void
+mido_uart_write(uint32_t offset, uint32_t value)
+{
+	*((volatile uint32_t *)(mido_uart_base + offset)) = value;
+}
+
+static unsigned int
+mido_uart_transmit_ready(void)
+{
+	return (mido_uart_read(MIDO_UART_SR) & MIDO_UART_SR_TXRDY) != 0;
+}
+
+static void
+mido_uart_transmit_data(uint8_t value)
+{
+	mido_uart_write(MIDO_UART_TF, value);
+}
+
+static unsigned int
+mido_uart_receive_ready(void)
+{
+	return (mido_uart_read(MIDO_UART_SR) & MIDO_UART_SR_RXRDY) != 0;
+}
+
+static uint8_t
+mido_uart_receive_data(void)
+{
+	return (uint8_t)mido_uart_read(MIDO_UART_RF);
+}
+
+static void
+mido_uart_init(void)
+{
+	if (mido_gcc_base != 0) {
+		volatile uint32_t *ahb =
+		    (volatile uint32_t *)(mido_gcc_base + MIDO_GCC_BLSP1_AHB_CBCR);
+		volatile uint32_t *apps =
+		    (volatile uint32_t *)(mido_gcc_base + MIDO_GCC_UART1_APPS_CBCR);
+		*ahb |= 1U;
+		*apps |= 1U;
+	}
+	mido_uart_write(MIDO_UART_CR, 0);
+	mido_uart_write(MIDO_UART_MR1, 0);
+	mido_uart_write(MIDO_UART_MR2, 0x30);
+	mido_uart_write(MIDO_UART_CSR, MIDO_UART_CSR_115200);
+	mido_uart_write(MIDO_UART_CR, MIDO_UART_CR_RX_EN | MIDO_UART_CR_TX_EN);
+}
+
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions)
+    mido_uart_serial_functions = {
+	.init = mido_uart_init,
+	.transmit_ready = mido_uart_transmit_ready,
+	.transmit_data = mido_uart_transmit_data,
+	.receive_ready = mido_uart_receive_ready,
+	.receive_data = mido_uart_receive_data,
+	.device = SERIAL_MIDO_UART
+};
+#endif /* MIDO */
 
